# Variables usadas por docker-compose.yml para levantar el stack completo en local.
# Copiar como .env en la raíz: cp .env.example .env
# Cada app (apps/api, apps/web) tiene ADEMÁS su propio .env.example más detallado.

# --- Postgres (contenedor local) ---
POSTGRES_USER=esencia
POSTGRES_PASSWORD=esencia_dev_password
POSTGRES_DB=esencia
POSTGRES_PORT=5432

# --- Redis (contenedor local) ---
REDIS_PORT=6379

# --- API ---
API_PORT=8080
DATABASE_URL=postgresql://esencia:esencia_dev_password@postgres:5432/esencia?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=cambia_este_valor_en_local_por_uno_generado_con_openssl
JWT_REFRESH_SECRET=cambia_este_otro_valor_tambien
CORS_ORIGIN=http://localhost:5173

# --- Web ---
VITE_API_URL=http://localhost:8080
