# Copiar como .env dentro de apps/api/ para correr `npm run dev` sin Docker Compose.
# En producción (Render), estas variables se configuran en el panel del Web Service,
# nunca en un archivo versionado. Ver docs/05-modelos-cloud.md, sección 4.

PORT=8080
NODE_ENV=development

# Postgres — en local con docker-compose, o la URL del pooler de Supabase en producción
DATABASE_URL=postgresql://esencia:esencia_dev_password@localhost:5432/esencia?schema=public
DIRECT_URL=postgresql://esencia:esencia_dev_password@localhost:5432/esencia?schema=public

# Redis — en local con docker-compose, o la URL de Upstash en producción
REDIS_URL=redis://localhost:6379

# JWT — generar valores propios en local, por ejemplo con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia_este_valor_en_local
JWT_REFRESH_SECRET=cambia_este_otro_valor_tambien
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — origen del frontend (Vite en local, dominio de Vercel en producción)
CORS_ORIGIN=http://localhost:5173
# Varios orígenes se separan con comas.

# Proxies delante de la API: 1 en local; 2 en producción (Vercel → Render).
TRUST_PROXY=1

# SameSite de la cookie de sesión: lax (con el proxy de Vercel) | strict | none (API en otro dominio).
COOKIE_SAME_SITE=lax

# Observabilidad (opcional en local)
SENTRY_DSN=
LOG_LEVEL=info
